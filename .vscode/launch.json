{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug tunnel (with sudo)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/tunnel",
            "args": [
                "--tun", "tun0",
                "--listen", "10.0.0.1:5000",
                "--peer", "10.0.0.2:5000",
                "--key", "/tmp/tunnel.key"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "make",
            "pipeTransport": {
                "pipeCwd": "${workspaceFolder}",
                "pipeProgram": "sudo",
                "pipeArgs": [],
                "debuggerPath": "/usr/bin/gdb"
            }
        }
    ]
}